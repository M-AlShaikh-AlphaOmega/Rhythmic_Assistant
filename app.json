{
  "expo": {
    "name": "aCare Home",
    "slug": "aCare Home",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand-badge-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/brand-badge-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/brand-badge-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand-badge-icon.png",
        "backgroundColor": "#ffffff"
      },
      "icon": "./assets/brand-badge-icon.png",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Rhythmic_Assistant"
    },
    "web": {
      "favicon": "./assets/brand-badge-icon.png"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
